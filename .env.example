# Identifiant du client OAuth 2.0 Google de type « Application Web ».
GOOGLE_CLIENT_ID=

# Secret du client OAuth Google. Cette valeur doit rester exclusivement côté serveur.
GOOGLE_CLIENT_SECRET=

# URI de rappel locale. Elle doit correspondre exactement à celle déclarée dans Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Seule adresse Google Workspace autorisée à se connecter dans cette première version.
GOOGLE_ALLOWED_EMAIL=

# Clé OpenAI exclusivement serveur. Ne jamais utiliser de préfixe NEXT_PUBLIC_.
OPENAI_API_KEY=

# Modèle de repli commun. Utilisez uniquement un nom de modèle réellement disponible pour votre projet.
OPENAI_MODEL=

# Modèles optionnels par opération ; une valeur vide utilise OPENAI_MODEL.
OPENAI_MAIL_ANALYSIS_MODEL=
OPENAI_MAIL_REPLY_MODEL=
OPENAI_MAIL_REWRITE_MODEL=

# Active l’appel OpenAI pour Mail. Avec false ou une configuration incomplète, le mode déterministe est utilisé.
OPENAI_MAIL_AI_ENABLED=false

# Plafonds serveur optionnels. Des valeurs conservatrices validées sont utilisées si ces champs restent vides.
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_MS=
OPENAI_DAILY_REQUEST_LIMIT=

# Préfixe stable optionnel pour optimiser le cache de prompts OpenAI.
OPENAI_PROMPT_CACHE_KEY_PREFIX=
